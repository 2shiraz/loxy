# Loxy configuration (INSTRUCTIONS.md §16.4). Copy to .env and chmod 0600.

# Pinned HAProxy image version (same for the haproxy and loxy containers).
HAPROXY_VERSION=3.4.6
# Loxy release (image tag ghcr.io/2shiraz/loxy:${LOXY_VERSION}-haproxy${HAPROXY_VERSION}).
LOXY_VERSION=

# 32 random bytes, base64. Encrypts secrets at rest. The installer generates it;
# by hand: openssl rand -base64 32
LOXY_SECRET_KEY=

# Internal HTTP listener (never expose publicly).
LOXY_LISTEN=127.0.0.1:9090
# Port of the sys_panel frontend served by HAProxy.
LOXY_PANEL_PORT=8443
# If set, a managed certificate is issued for the panel.
LOXY_PANEL_DOMAIN=
# Comma-separated CIDRs allowed to reach the panel (empty = any).
LOXY_PANEL_ALLOW=

# ACME account contact and directory (default: Let's Encrypt production).
LOXY_ACME_EMAIL=
LOXY_ACME_DIRECTORY=https://acme-v02.api.letsencrypt.org/directory

# Paths inside the loxy container.
LOXY_DATA_DIR=/var/lib/loxy
LOXY_HAPROXY_CONF_DIR=/usr/local/etc/haproxy
LOXY_HAPROXY_RUN_DIR=/run/haproxy
# haproxy binary used for `haproxy -c` validation.
LOXY_HAPROXY_BIN=haproxy

# Stats poll interval and log level (debug|info|warn|error).
LOXY_STATS_INTERVAL=1s
LOXY_LOG_LEVEL=info

# Development mode (relaxed cookies, verbose errors). Never true in production.
LOXY_DEV=false
